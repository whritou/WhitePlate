BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# For a Coolify/custom CA, supply the PEM (real newlines or literal \n).
# When set, DATABASE_URL must omit ssl/sslmode/sslcert/sslkey/sslrootcert parameters.
DATABASE_SSL_CA=
API_BASE_URL=http://localhost:5182
# Browser-reachable SignalR origin; falls back to API_BASE_URL when empty.
PUBLIC_API_BASE_URL=
API_AUDIENCE=whiteplate-api

# Optional local Swagger token helper credentials; keep real values in .env.local.
WHITEPLATE_DEV_EMAIL=local-tester@whiteplate.invalid
WHITEPLATE_DEV_PASSWORD=replace-with-your-local-test-account-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

RESEND_API_KEY=
RESEND_FROM_EMAIL=WhitePlate <auth@example.com>

# Public tenant storefront routing (server only)
STOREFRONT_BASE_DOMAIN=localhost
PUBLIC_TENANT_API_URL_TEMPLATE=http://{tenant}.localhost:5182
