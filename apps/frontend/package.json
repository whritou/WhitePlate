{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "auth:generate": "auth generate --config ./lib/auth.ts",
    "auth:migrate": "auth migrate --config ./lib/auth.ts",
    "auth:dev-token": "node ./scripts/dev-token.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/infra": "^0.4.12",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "kysely": "^0.28.17",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.6",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
